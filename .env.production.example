# ─── Production Server Configuration ───────────────────────
PORT=5000
NODE_ENV=production
CLIENT_URL=https://devduel.com

# ─── Security ──────────────────────────────────────────────
JWT_SECRET=generate_a_random_64_char_secret_key_here_for_production
JWT_EXPIRES_IN=7d
ELO_K_FACTOR=32

# ─── Database Configuration ────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=devduel_prod
DB_USER=devduel_admin
DB_PASSWORD=a_very_strong_db_password_123!
DATABASE_URL=postgres://devduel_admin:a_very_strong_db_password_123!@postgres:5432/devduel_prod

# ─── Redis Configuration ───────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Judge0 Sandboxed Execution Service ────────────────────
JUDGE0_URL=http://judge0_server:2358

# ─── OAuth Credentials ─────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://devduel.com/api/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://devduel.com/api/auth/github/callback
